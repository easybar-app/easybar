{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.5",
    "path": [
      "?.lua",
      "?/init.lua",
      "shared/?.lua",
      "shared/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "~/.local/share/easybar/easybar_api.lua"
    ]
  },
  "diagnostics": {
    "globals": [
      "easybar"
    ]
  }
}
